# Copy to .env before running:  cp .env.example .env
# Every value below has a working default — the app runs without edits.

# --------------------
# Django / Backend
# --------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ENV=development

# --------------------
# Database
# --------------------
# USE_SQLITE=1 (the default in development) keeps local setup to one command.
# docker-compose sets USE_SQLITE=0 so containers use the PostgreSQL service.
USE_SQLITE=1
POSTGRES_DB=stock_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --------------------
# Celery / Redis
# --------------------
# Only needed for the async agent pipeline. The dashboard works without them.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --------------------
# Demo data
# --------------------
# 1 makes the web container migrate, create admin/admin123 and seed live data.
SEED_DEMO_DATA=1

# --------------------
# AI / LLM API Keys (optional)
# --------------------
# Market data and the dashboard need no key. These drive the LangChain agent
# pipeline that runs through Celery.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --------------------
# Frontend
# --------------------
# Leave VITE_API_URL empty to keep requests same-origin (dev proxy or reverse
# proxy). Set it to an absolute origin when the API is on another host.
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:8000

# --------------------
# CORS
# --------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
